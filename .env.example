# Pegasus CRM environment variables.
#
# Copy this file to `.env.local` for host-based dev (Next.js runs with
# `npm run dev`, backing services from docker-compose.yml), or to `.env.prod`
# on the VM for `docker compose -f docker-compose.prod.yml up`.
#
# .env* files are gitignored — never commit real secrets.

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
NODE_ENV=development

# Public URL the app is reached at. In prod this must match APP_DOMAIN
# (with https://). Used by Better Auth for callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# 32+ random bytes, hex-encoded. Generate with:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=change_me_generate_with_openssl_rand_hex_32

# ------------------------------------------------------------------
# Postgres
#
# We use TWO roles by design:
#
#   * `pegasus`     — superuser. Owns the database, runs migrations and
#                     the seed. Postgres superusers bypass RLS entirely,
#                     which is exactly what we want for schema management.
#
#   * `pegasus_app` — non-superuser (NOSUPERUSER, NOBYPASSRLS). The app
#                     runtime connects as this role, so RLS policies
#                     actually enforce tenant isolation at the DB level.
#                     Created on first Postgres boot by
#                     docker/postgres-init/01-app-user.sh.
#
# `DATABASE_URL` is the app-runtime URL. `MIGRATION_DATABASE_URL` is used
# by npm run db:migrate / db:seed (falls back to DATABASE_URL if unset).
# ------------------------------------------------------------------
POSTGRES_USER=pegasus
POSTGRES_PASSWORD=pegasus_dev
POSTGRES_DB=pegasus
POSTGRES_PORT=5432

PEGASUS_APP_USER=pegasus_app
PEGASUS_APP_PASSWORD=pegasus_app_dev

# App runtime — non-superuser, RLS enforced.
DATABASE_URL=postgres://pegasus_app:pegasus_app_dev@localhost:5432/pegasus

# Migrations + seed — superuser, RLS bypassed.
MIGRATION_DATABASE_URL=postgres://pegasus:pegasus_dev@localhost:5432/pegasus

# ------------------------------------------------------------------
# Redis (BullMQ queue + cache)
# ------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------
# Object storage (S3-compatible)
#
# Local dev / self-hosted prod: MinIO
#   S3_ENDPOINT=http://localhost:9000   (dev, host)
#   S3_ENDPOINT=http://minio:9000       (prod, compose network)
#   S3_FORCE_PATH_STYLE=true
#
# Production with Cloudflare R2:
#   S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=false
#   (leave MINIO_* unset, remove the minio services from prod compose)
# ------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pegasus
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_admin_dev
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM="Pegasus CRM <noreply@example.com>"

# ------------------------------------------------------------------
# Production only — Caddy needs this to fetch an HTTPS cert.
# Set to your public domain, e.g. app.pegasus.example.com.
# The DNS A record must point at the VM before first startup.
# ------------------------------------------------------------------
APP_DOMAIN=app.example.com
