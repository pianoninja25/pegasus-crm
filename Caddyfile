# Caddy config for Pegasus CRM production.
#
# Default: HTTP-only on port 80.
#   Works for IP-only deployments (Let's Encrypt cannot issue certs
#   for raw IP addresses) and also fine for local prod-mode testing.
#
# To enable HTTPS once you have a domain:
#   1. Point an A record at this VM's public IP.
#   2. Set APP_DOMAIN=your.domain.com in .env.prod
#      (the app service also reads it for BETTER_AUTH_URL etc).
#   3. Replace the ":80" site address below with {$APP_DOMAIN}
#      — Caddy will auto-provision + renew a Let's Encrypt cert.
#   4. docker compose -f docker-compose.prod.yml restart caddy
#
# If you later put Caddy behind another proxy (Cloudflare, an ALB, etc.),
# add a global block above the site to trust that upstream:
#   {
#     servers {
#       trusted_proxies static private_ranges
#     }
#   }

:80 {
	encode zstd gzip

	# Cache Next.js immutable build assets aggressively.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# reverse_proxy auto-sets X-Forwarded-For / X-Forwarded-Proto.
	reverse_proxy app:3000
}
